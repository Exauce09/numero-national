# Application
APP_NAME=Systeme National d Identite
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Security — replace in production; never commit real secrets
# Use long random values (>= 32 chars). Prefer splitting keys in production.
SECRET_KEY=change-me-generate-a-strong-random-secret-min-32chars
# JWT_SECRET_KEY=
# MFA_ENCRYPTION_KEY=
# QR_HMAC_KEY=
QR_KEY_ID=qr-v1

# Auth hardening
# Dev only: allow X-Actor-Id / X-Permissions headers (NEVER in production)
ALLOW_DEV_AUTH_HEADERS=true
# Dev only: open /auth/register without admin token
ALLOW_OPEN_REGISTRATION=true
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
MFA_ISSUER=NumeroNational
MFA_DIGITS=6
MFA_INTERVAL=30
MFA_VALID_WINDOW=1

# HTTP
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nic_admin
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=nic_core

# Logging
REDIS_URL=redis://localhost:6379/0
LOGIN_MAX_FAILURES=8
